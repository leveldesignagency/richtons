# Canonical site URL for sitemap and metadata (no trailing slash).
# Optional locally; defaults to https://richtons.co.uk when unset.
# On Vercel, set this to your production domain (e.g. https://richtons.co.uk).
NEXT_PUBLIC_SITE_URL=https://richtons.co.uk

# Contact form delivery (Resend API)
RESEND_API_KEY=
# Optional; defaults to tony@richtons.co.uk when unset
CONTACT_TO_EMAIL=tony@richtons.co.uk
# Optional sender; use verified domain address when ready
CONTACT_FROM_EMAIL=Richtons Contact <onboarding@resend.dev>
